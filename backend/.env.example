GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-random-64-char-hex-string
# Set to true once the app is served over HTTPS (production). Must stay
# false for local http://localhost development, or the session cookie
# won't be sent by the browser at all.
COOKIE_SECURE=false
